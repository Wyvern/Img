{
  "llvm-target": "sparc64-sun-solaris",
  "target-endian": "big",
  "target-pointer-width": "64",
  "target-c-int-width": "32",
  "data-layout": "E-m:e-i64:64-f128:128-n32:64-S128",
  "arch": "sparc64",
  "os": "solaris",
  "env": "",
  "vendor": "sun",
  "linker-flavor": "gcc",
  "pre-link-args": {
    "gcc": ["-m64"]
  },
  "post-link-args": {
    "gcc": []
  },
  "dynamic-linking": true,
  "executables": true,
  "relocation-model": "pic",
  "tls-model": "initial-exec",
  "frame-pointer": "always",
  "cpu": "v9",
  "features": "+v9",
  "max-atomic-width": 64,
  "disable-redzone": true
}
