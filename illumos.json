{
  "arch": "x86_64",
  "cpu": "x86-64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "frame-pointer": "always",
  "has-rpath": true,
  "is-like-solaris": false,
  "late-link-args": {
    "unix-cc": ["-lc", "-lssp"]
  },
  "limit-rdylib-exports": false,
  "linker-flavor": "unix-cc",
  "linker-is-gnu": false,
  "llvm-target": "x86_64-pc-solaris",
  "max-atomic-width": 64,
  "metadata": {
    "description": "illumos",
    "host_tools": true,
    "std": true,
    "tier": 2
  },
  "os": "illumos",
  "plt-by-default": false,
  "pre-link-args": {
    "unix-cc": ["-m64", "-std=c99"]
  },
  "supported-sanitizers": ["address", "thread", "cfi"],
  "target-family": ["unix"],
  "target-pointer-width": 64
}
