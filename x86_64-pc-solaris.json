{
  "llvm-target": "x86_64-pc-solaris",
  "target-endian": "little",
  "target-pointer-width": "64",
  "target-c-int-width": "32",
  "data-layout": "e-m:e-i64:64-f80:128-n8:16:32:64-S128",
  "arch": "x86_64",
  "os": "solaris",
  "env": "",
  "vendor": "pc",
  "linker-flavor": "gcc",
  "pre-link-args": {
    "gcc": ["-m64"]
  },
  "post-link-args": {
    "gcc": []
  },
  "dynamic-linking": true,
  "executables": true,
  "relocation-model": "pic",
  "code-model": "default",
  "tls-model": "initial-exec",
  "frame-pointer": "always",
  "features": "+sse2",
  "max-atomic-width": 64,
  "disable-redzone": false
}
