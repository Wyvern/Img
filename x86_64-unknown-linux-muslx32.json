
{
  "abi": "x32",
  "arch": "x86_64",
  "cpu": "x86-64",
  "crt-objects-fallback": "false",
  "crt-static-respected": true,
  "data-layout": "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "default-uwtable": true,
  "dynamic-linking": true,
  "env": "musl",
  "has-rpath": true,
  "linker-flavor": "gnu-cc",
  "llvm-target": "x86_64-unknown-linux-muslx32",
  "max-atomic-width": 64,
  "metadata": {
    "description": "64-bit Linux (x32 ABI) (musl)",
    "host_tools": false,
    "std": true,
    "tier": null
  },
  "os": "linux",
  "position-independent-executables": true,
  "pre-link-args": {
    "gnu-cc": [
      "-mx32"
    ],
    "gnu-lld-cc": [
      "-mx32"
    ]
  },
  "relro-level": "full",
  "stack-probes": {
    "kind": "inline"
  },
  "static-position-independent-executables": true,
  "supported-split-debuginfo": [
    "packed",
    "unpacked",
    "off"
  ],
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 32
}
