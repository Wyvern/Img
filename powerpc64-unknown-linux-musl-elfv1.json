{
  "llvm-target": "powerpc64-unknown-linux-gnu",
  "data-layout": "E-m:e-i64:64-n32:64-S128",
  "target-endian": "big",
  "target-pointer-width": "64",
  "target-c-int-width": 32,
  "arch": "powerpc64",
  "os": "linux",
  "env": "musl",
  "vendor": "unknown",

  "linker": "powerpc64-linux-gnu-gcc",
  "linker-flavor": "gcc",
  "linker-is-gnu": true,

  "executables": true,
  "dynamic-linking": false,
  "crt-static-default": true,
  "crt-static-respected": true,
  "relocation-model": "static",
  "code-model": "large",
  "panic-strategy": "abort",
  "disable-redzone": true,
  "function-sections": true,
  "has-rpath": false,
  "target-family": ["unix"],
  "max-atomic-width": 64,

  "features": "-vsx,-altivec",

  "pre-link-args": {
    "gcc": ["-mabi=elfv1"]
  }
}
