{
  "arch": "sparc64",
  "cpu": "v9",
  "crt-objects-fallback": "false",
  "data-layout": "E-m:e-i64:64-i128:128-n32:64-S128",
  "default-dwarf-version": 2,
  "dynamic-linking": false,
  "has-rpath": true,
  "has-thread-local": true,
  "linker-flavor": "gnu-cc",
  "llvm-target": "sparc64-unknown-netbsd",
  "max-atomic-width": 64,
  "metadata": {
    "description": "NetBSD/sparc64",
    "host_tools": true,
    "std": true,
    "tier": 3
  },
  "no-default-libraries": false,
  "os": "netbsd",
  "position-independent-executables": false,
  "pre-link-args": {
    "gnu-cc": ["-m64"],
    "gnu-lld-cc": ["-m64"]
  },
  "relro-level": "full",
  "target-endian": "big",
  "target-family": ["unix"],
  "target-mcount": "__mcount",
  "target-pointer-width": 64,
  "use-ctors-section": true
}
